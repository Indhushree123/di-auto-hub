pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out DI Auto Hub project...'
            }
        }

        stage('Build') {
            steps {
                echo 'Building DI Auto Hub project...'
            }
        }

        stage('Test') {
            steps {
                echo 'Testing DI Auto Hub project...'
            }
        }
        stage('Docker Build') {
            steps {
                bat 'docker build -t di-auto-hub:latest .'
            }
        }
        stage('Docker Push') {
    steps {
        withCredentials([usernamePassword(
            credentialsId: 'dockerhub',
            usernameVariable: 'DOCKER_USER',
            passwordVariable: 'DOCKER_PASS'
        )]) {
            bat 'echo %DOCKER_PASS% | docker login -u %DOCKER_USER% --password-stdin'
            bat 'docker tag di-auto-hub:latest %DOCKER_USER%/di-auto-hub:latest'
            bat 'docker push %DOCKER_USER%/di-auto-hub:latest'
        }
    }
}
    }

    post {
        success {
            echo 'DI Auto Hub Pipeline completed successfully!'
        }

        failure {
            echo 'Pipeline failed!'
        }
    }
}